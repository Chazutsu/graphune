{
  "name": "graphune",
  "version": "0.1.3",
  "private": true,
  "packageManager": "pnpm@10.7.0",
  "pnpm": {
    "overrides": {
      "@parcel/watcher": "2.6.0",
      "tinypool": "2.1.2"
    }
  },
  "engines": { "node": ">=24" },
  "license": "MIT",
  "repository": "github:Chazutsu/graphune",
  "keywords": [
    "obsidian",
    "canvas",
    "knowledge-management"
  ],
  "description": "Spatial knowledge exploration for Obsidian Canvas",
  "main": "main.js",
  "scripts": {
    "dev": "node scripts/dev-watch.mjs",
    "build": "BUILD=production rolldown -c && tailwindcss -i src/styles.css -o styles.css --minify",
    "check:toolchain": "node scripts/check-toolchain-compat.mjs",
    "check:deploy": "pnpm build && node scripts/deploy.mjs --check",
    "deploy": "pnpm build && node scripts/deploy.mjs",
    "migrate:legacy": "node scripts/migrate-legacy-install.mjs",
    "css": "tailwindcss -i src/styles.css -o styles.css --watch",
    "test": "vitest run",
    "test:visual": "playwright test --config playwright.config.ts",
    "test:visual:update": "playwright test --config playwright.config.ts --update-snapshots",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src/ tests/",
    "check:obsidian": "eslint src package.json",
    "format": "oxfmt --write src/ tests/",
    "format:check": "oxfmt --check src/ tests/",
    "setup:link": "node scripts/setup-dev-link.mjs",
    "setup:device": "node scripts/setup-device-test.mjs",
    "open:device": "node scripts/open-device-test.mjs",
    "dev:ui": "node scripts/dev-ui.mjs"
  },
  "devDependencies": {
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.13",
    "@eslint/js": "9.39.5",
    "@eslint/json": "0.14.0",
    "@playwright/test": "1.64.0",
    "@tailwindcss/cli": "4.2.0",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@types/node": "^26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/coverage-v8": "4.1.11",
    "eslint": "9.39.3",
    "eslint-plugin-obsidianmd": "0.4.2",
    "jsdom": "^28.1.0",
    "obsidian": "1.14.4",
    "oxfmt": "0.34.0",
    "oxlint": "^1.48.0",
    "rolldown": "1.0.0-rc.5",
    "tailwindcss": "4.2.0",
    "typescript": "6.0.0-beta",
    "typescript-eslint": "8.71.2",
    "virtual-obsidian": "https://github.com/Chazutsu/virtual-obsidian/archive/refs/tags/v0.1.0.tar.gz",
    "vite": "8.0.0-beta.15",
    "vitest": "4.1.11"
  },
  "dependencies": {
    "obsidian-plugin-kit": "https://github.com/Chazutsu/obsidian-plugin-kit/archive/refs/tags/v0.1.0.tar.gz",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  }
}
