{
  "extends": "obsidian-plugin-kit/tsconfig",
  "compilerOptions": {
    "types": ["node"],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "dev/main.tsx",
    "dev/mock-app.ts",
    "dev/styles.d.ts",
    "playwright.config.ts",
    "rolldown.config.ts"
  ],
  "exclude": ["node_modules", "dist", "tests"]
}
